# DeepSeek API (required)
DEEPSEEK_API_KEY=sk-your-key-here

# DeepSeek base URL (default: https://api.deepseek.com)
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Model (default: deepseek-chat)
# DEEPSEEK_MODEL=deepseek-chat

# Embedding model (default: BAAI/bge-large-zh-v1.5)
# RAG_EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

# Embedding device: cpu or cuda
# RAG_EMBEDDING_DEVICE=cpu

# Chunking
# RAG_CHUNK_SIZE=400
# RAG_CHUNK_OVERLAP=60

# Default top-k for retrieval
# RAG_DEFAULT_TOP_K=8

# Source documents directory (default: ./2025text)
# RAG_DOCS_DIR=./2025text

# Data directory (default: ./data)
# RAG_DATA_DIR=./data
