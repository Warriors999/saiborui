# ============================================================
# 赛博瑞 全云端管线 — API 密钥配置
# 所有语音转文字、画面分析、深度拆解均走云端API
# 本地只做下载和传输，零模型推理，CPU占用 ≈ 0
# ============================================================

# ── DeepSeek API (required — 文案深度拆解 + 分镜生成) ──
DEEPSEEK_API_KEY=sk-your-key-here

# ── 智谱 GLM API (推荐 — 视觉分析 + 语音转文字) ──
# ZHIPU_API_KEY=your-zhipu-key
# 获取: https://open.bigmodel.cn/

# ── 语音转文字 (至少选一个) ──
# 方案A: Gemini Audio (推荐 — 免费额度1500次/天，同时可用于视觉)
GEMINI_API_KEY=your-gemini-key
# 获取: https://aistudio.google.com/apikey

# 方案B: OpenAI Whisper API ($0.006/分钟)
# OPENAI_API_KEY=sk-your-openai-key

# ── 画面视觉分析 (至少选一个) ──
# 方案A: Gemini Vision (和音频用同一个 GEMINI_API_KEY)
# 方案B: OpenAI Vision (GPT-4V)
# OPENAI_API_KEY=sk-your-openai-key
# VISION_MODEL=gpt-4o

# ── DeepSeek 配置 ──
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# ── 其他 ──
# RAG_EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
# RAG_EMBEDDING_DEVICE=cpu

# ── AI 图像生成 (gpt-image-2 / DALL-E 兼容接口) ──
# IMAGE_GEN_API_KEY=sk-your-image-gen-key
# IMAGE_GEN_BASE_URL=https://us.pinai-cn.com/v1
# IMAGE_GEN_MODEL=gpt-image-2
